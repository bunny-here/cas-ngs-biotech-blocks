{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cas-ngs/interactive-pipeline-hero",
  "version": "1.4.0",
  "title": "Act 0: Interactive 3D Pipeline Hero",
  "category": "cas-ngs-biotech",
  "icon": "superhero",
  "description": "4-frame 3D interactive sequencing pipeline ('From Sample to Code') featuring GSAP Observer single-flick locking, dynamic Three.js ribbon chromatogram, genomic matrix stream, and seamless scroll-lock hand-off.",
  "keywords": [
    "pipeline",
    "3d",
    "helix",
    "pre-hero",
    "sequencer",
    "interactive"
  ],
  "textdomain": "cas-ngs-biotech-blocks",
  "attributes": {
    "fx_enabled": {
      "type": "boolean",
      "default": true
    },
    "canvas_bg": {
      "type": "string",
      "default": "#f8f6f0"
    },
    "auto_scroll_speed": {
      "type": "number",
      "default": 1.0
    },
    "model_url": {
      "type": "string",
      "default": ""
    },
    "fig1_label": {
      "type": "string",
      "default": "Fig. 01"
    },
    "fig1_phase": {
      "type": "string",
      "default": "Wet Lab"
    },
    "fig1_title": {
      "type": "string",
      "default": "Sample Extraction"
    },
    "fig1_copy": {
      "type": "string",
      "default": "High-molecular-weight DNA is isolated from the specimen and held in stable suspension — 3.2 billion base pairs awaiting their first reading."
    },
    "fig1_sample_id": {
      "type": "string",
      "default": "CS-0427 · HMW DNA"
    },
    "fig1_yield": {
      "type": "string",
      "default": "2.4 ng/µL · QC pass"
    },
    "fig1_cta_text": {
      "type": "string",
      "default": "Request a kit"
    },
    "fig1_cta_url": {
      "type": "string",
      "default": "#contact"
    },
    "fig2_label": {
      "type": "string",
      "default": "Fig. 02"
    },
    "fig2_phase": {
      "type": "string",
      "default": "Flowcell"
    },
    "fig2_title": {
      "type": "string",
      "default": "High-Throughput Sequencing"
    },
    "fig2_copy": {
      "type": "string",
      "default": "The camera rides the backbone into the optics bench, where four ribbon traces — one per base — stream horizontally across the flowcell."
    },
    "fig2_flowcell_id": {
      "type": "string",
      "default": "04 · 2×150 bp"
    },
    "fig2_channels": {
      "type": "string",
      "default": "4 · signal live"
    },
    "fig3_label": {
      "type": "string",
      "default": "Fig. 03"
    },
    "fig3_phase": {
      "type": "string",
      "default": "Compute"
    },
    "fig3_title": {
      "type": "string",
      "default": "Basecalling & Assembly"
    },
    "fig3_copy": {
      "type": "string",
      "default": "Signal becomes sequence. Neural basecalling resolves the traces into a streaming genomic code — A·T·C·G aligned against the reference in real time."
    },
    "fig3_quality": {
      "type": "string",
      "default": "Q30 93.1% · 2.4B reads"
    },
    "fig3_stream": {
      "type": "string",
      "default": "Live · lane 2"
    },
    "fig4_label": {
      "type": "string",
      "default": "Fig. 04"
    },
    "fig4_phase": {
      "type": "string",
      "default": "Insight"
    },
    "fig4_title": {
      "type": "string",
      "default": "Variant Analysis"
    },
    "fig4_copy": {
      "type": "string",
      "default": "Aligned reads condense into an expression matrix and a phylogenetic tree. Variants are called, annotated and released for review."
    },
    "fig4_ref": {
      "type": "string",
      "default": "GRCh38 · 4,182 variants"
    },
    "fig4_report": {
      "type": "string",
      "default": "Ready for review"
    },
    "fig4_cta_text": {
      "type": "string",
      "default": "View sample report"
    },
    "fig4_cta_url": {
      "type": "string",
      "default": "#report"
    },
    "rail_name_1": {
      "type": "string",
      "default": "01 · Sample"
    },
    "rail_name_2": {
      "type": "string",
      "default": "02 · Sequencing"
    },
    "rail_name_3": {
      "type": "string",
      "default": "03 · Basecalling"
    },
    "rail_name_4": {
      "type": "string",
      "default": "04 · Variants"
    },
    "ticker_string_1": {
      "type": "string",
      "default": "SAMPLE CS-0427 · QC PASS · 2.4 ng/µL · LOADING FLOWCELL 04"
    },
    "ticker_string_2": {
      "type": "string",
      "default": "FOUR-CHANNEL OPTICS · SIGNAL ACQUIRED"
    }
  },
  "supports": {
    "align": [
      "full"
    ],
    "html": false
  },
  "style": "cas-ngs-biotech-blocks-css",
  "editorScript": "cas-ngs-biotech-blocks-editor"
}
