{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cas-ngs/act4-cta-banner",
  "version": "1.3.0",
  "title": "Act 4: Conversion CTA Banner",
  "category": "cas-ngs-biotech",
  "icon": "megaphone",
  "description": "Full-width high-impact biotech CTA card with dual pill buttons and background ambient lighting.",
  "keywords": [
    "biotech",
    "cta",
    "conversion",
    "banner",
    "quote"
  ],
  "textdomain": "cas-ngs-biotech-blocks",
  "attributes": {
    "badge_text": {
      "type": "string",
      "default": "Accelerate Your Scientific Discovery"
    },
    "banner_heading": {
      "type": "string",
      "default": "Ready to Start Your Sequencing Run?"
    },
    "banner_subtext": {
      "type": "string",
      "default": "From pilot project library preparation to full PromethION 24 flowcell cohorts and institutional pipeline deployments, our team is ready to scale your genomics workflow."
    },
    "primary_cta_text": {
      "type": "string",
      "default": "Request a Quote"
    },
    "primary_cta_url": {
      "type": "string",
      "default": "/request-a-quote/"
    },
    "secondary_cta_text": {
      "type": "string",
      "default": "Client Portal Access"
    },
    "secondary_cta_url": {
      "type": "string",
      "default": "/portal/"
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "style": "cas-ngs-biotech-blocks-css",
  "render": "file:./render.php",
  "editorScript": "cas-ngs-biotech-blocks-editor"
}
